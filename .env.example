# ==============================================================================
# SOVEREIGN • Private 3D Sicbo Salon — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local development (NEVER commit `.env` to Git).
# On Vercel, configure these in: Project Settings -> Environment Variables.
# ==============================================================================

# --- Server & Environment -----------------------------------------------------
PORT=3000
NODE_ENV=development
# Automatically set to "1" by Vercel Serverless Runtime (leave unset locally)
# VERCEL=1

# --- Cryptographic Secrets (REQUIRED in Production / Vercel) ------------------
# Generate strong 32-byte (64-hex-char) CSPRNG secrets using either command:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#
# Local mode (!VERCEL): if left blank, `lib/config.js` auto-generates and
# persists CSPRNG secrets in `data/.secrets.json`.
# Vercel mode (VERCEL=1): if unset, app stays non-crashing using ephemeral
# per-instance CSPRNG secrets (`secretsDegraded: true`) + console warning,
# meaning sessions and live commitments will NOT persist across cold starts.
JWT_SECRET=
LIVE_MASTER_SECRET=

# --- Admin Ops (RBAC) ---------------------------------------------------------
# First registered account matching ADMIN_USERNAME receives role="admin"
ADMIN_USERNAME=
# Optional seed/bootstrap password for admin initialization (if used)
# ADMIN_PASSWORD=

# --- Cloud Database (Required for Durable Persistence on Vercel) --------------
# Driver priority: (1) Upstash Redis REST -> (2) PostgreSQL -> (3) JSON fallback
# Option 1 (Recommended for Vercel Serverless): Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option 2: PostgreSQL connection string (requires `pg` dependency if used)
# DATABASE_URL=
